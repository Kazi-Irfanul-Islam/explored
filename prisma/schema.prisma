// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

model users {
  id               Int               @id @default(autoincrement())
  username         String            @unique @db.VarChar(100)
  password         String            @db.VarChar(255)
  role             Role              @default(user)
  
  travel_logs      travel_logs[]
  log_sections     log_sections[]
  comments         comments[]
  wishlists        wishlist[]
}

model contact_messages {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @db.VarChar(100)
  subject    String   @db.VarChar(100)
  message    String   @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)
}

model travel_logs {
  id           Int       @id @default(autoincrement())
  owner_id     Int
  title        String    @db.VarChar(150)
  description  String    @db.Text
  journey_type String    @db.VarChar(50)
  published    Int       @default(0) @db.TinyInt
  created_at   DateTime  @default(now()) @db.Timestamp(0)

  owner        users     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  
  log_sections log_sections[]
  comments     comments[]
  wishlists    wishlist[]

  @@index([owner_id], map: "ownership")
}

model log_sections {
  id         Int      @id @default(autoincrement())
  owner_id   Int
  log_id     Int
  place_name String   @db.VarChar(150)
  place_type String   @db.VarChar(50)
  map_link   String?  @default("Not Mentioned") @db.VarChar(255)
  avg_cost   Decimal  @db.Decimal(10, 2)
  rating     Int      @db.TinyInt
  created_at DateTime @default(now()) @db.Timestamp(0)

  owner      users       @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  log        travel_logs @relation(fields: [log_id], references: [id], onDelete: Cascade)

  @@index([owner_id], map: "section_owner")
  @@index([log_id], map: "section_log")
}

model comments {
  id         Int      @id @default(autoincrement())
  owner_id   Int
  log_id     Int
  comment    String   @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)

  owner      users       @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  log        travel_logs @relation(fields: [log_id], references: [id], onDelete: Cascade)

  @@index([owner_id], map: "comment_owner")
  @@index([log_id], map: "comment_log")
}

model wishlist {
  id       Int @id @default(autoincrement())
  user_id  Int
  log_id   Int

  user     users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  log      travel_logs @relation(fields: [log_id], references: [id], onDelete: Cascade)

  @@unique([user_id, log_id], map: "unique_wishlist")
  @@index([log_id], map: "wishlist_log")
}
